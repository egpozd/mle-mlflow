# Copy to .env; secrets stay outside Git. Reuse the existing .venv.
MLFLOW_STORAGE_MODE=local
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=real_estate_model_improvement
REGISTERED_MODEL_NAME=real_estate_price_model
MLFLOW_DB_HOST=127.0.0.1
MLFLOW_DB_PORT=5433
MLFLOW_DB_NAME=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=<database-password>
BASELINE_RECOVERY_DIR=<absolute-path-to-mle-baseline-recovery>
# Only for YANDEX / S3 FINAL RUN; use production PostgreSQL host/port above.
MLFLOW_ARTIFACT_ROOT=s3://<bucket>/<prefix>
MLFLOW_S3_ENDPOINT_URL=https://storage.yandexcloud.net
AWS_ACCESS_KEY_ID=<access-key>
AWS_SECRET_ACCESS_KEY=<secret-key>
AWS_DEFAULT_REGION=ru-central1
